generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  password     String
  role         UserRole   @default(ADMIN)
  isActive     Boolean    @default(true)
  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id])
  createdAt    DateTime   @default(now())

  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Restaurant {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  phone        String?
  email        String?
  address      String?
  logoUrl      String?
  coverUrl     String?
  logoShape    String   @default("rounded")
  primaryColor String   @default("#f07316")
  timezone     String   @default("America/Sao_Paulo")
  isActive     Boolean  @default(true)
  plan         String   @default("FREE")
  planExpiresAt DateTime?
  reservationsThisMonth Int @default(0)
  lastReservationCountReset DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users             User[]
  rooms             Room[]
  customers         Customer[]
  reservations      Reservation[]
  waitlistEntries   WaitlistEntry[]
  settings          RestaurantSettings?
  notificationLogs  NotificationLog[]
  menuCategories    MenuCategory[]
}

model RestaurantSettings {
  id                  String     @id @default(cuid())
  restaurantId        String     @unique
  restaurant          Restaurant @relation(fields: [restaurantId], references: [id])
  maxAdvanceDays      Int        @default(30)
  minNoticeMinutes    Int        @default(60)
  defaultSlotDuration Int        @default(90)
  noShowFeeEnabled    Boolean    @default(false)
  noShowFeeAmount     Float?
  autoConfirm         Boolean    @default(true)
  reminderHoursBefore Int        @default(24)
  whatsappEnabled     Boolean    @default(false)
  whatsappApiKey      String?
  averageTicket       Float?     @default(0)
}

model Room {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  name         String
  description  String?
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())

  tables    Table[]
  schedules Schedule[]
}

model Table {
  id          String  @id @default(cuid())
  roomId      String
  room        Room    @relation(fields: [roomId], references: [id])
  name        String
  capacity    Int
  minCapacity Int     @default(1)
  posX        Float   @default(0)
  posY        Float   @default(0)
  shape       String  @default("rectangle")
  isActive    Boolean @default(true)

  reservations Reservation[]
}

model Schedule {
  id           String  @id @default(cuid())
  roomId       String
  room         Room    @relation(fields: [roomId], references: [id])
  dayOfWeek    Int
  openTime     String
  closeTime    String
  slotInterval Int     @default(30)
  maxCapacity  Int
  isActive     Boolean @default(true)
  isOnline     Boolean @default(true)
}

model Customer {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  name         String
  phone        String?
  email        String?
  birthday     DateTime?
  notes        String?
  tags         String[]
  visitCount   Int        @default(0)
  noShowCount  Int        @default(0)
  isBlacklisted   Boolean  @default(false)
  blacklistReason String?
  allergies       String?
  preferences     String?
  favoriteTable   String?
  internalNotes   String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  reservations      Reservation[]
  waitlistEntries   WaitlistEntry[]
  notificationLogs  NotificationLog[]
  account           CustomerAccount?

  @@unique([restaurantId, phone])
}

model CustomerAccount {
  id         String   @id @default(cuid())
  email      String
  password   String
  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id])
  createdAt  DateTime @default(now())
}

model Reservation {
  id           String            @id @default(cuid())
  restaurantId String
  restaurant   Restaurant        @relation(fields: [restaurantId], references: [id])
  customerId   String?
  customer     Customer?         @relation(fields: [customerId], references: [id])
  tableId      String?
  table        Table?            @relation(fields: [tableId], references: [id])
  date         DateTime
  partySize    Int
  duration     Int               @default(90)
  status       ReservationStatus @default(CONFIRMED)
  origin       ReservationOrigin @default(INTERNAL)
  notes        String?
  occasion     String?
  noShowFee         Float?
  confirmToken      String?           @unique
  cancelToken       String?           @unique
  reminder24hSentAt DateTime?
  reminder2hSentAt  DateTime?
  postVisitSentAt   DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model WaitlistEntry {
  id            String         @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant     @relation(fields: [restaurantId], references: [id])
  customerId    String?
  customer      Customer?      @relation(fields: [customerId], references: [id])
  name          String
  phone         String
  partySize     Int
  status        WaitlistStatus @default(WAITING)
  estimatedWait Int?
  notes         String?
  createdAt     DateTime       @default(now())
  calledAt      DateTime?
  seatedAt      DateTime?
}

enum UserRole {
  MASTER_SUPER
  ADMIN
  GERENTE
  USUARIO
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  ARRIVED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ReservationOrigin {
  INTERNAL
  WIDGET
  GOOGLE
  INSTAGRAM
  WHATSAPP
  PHONE
}

enum WaitlistStatus {
  WAITING
  CALLED
  SEATED
  CANCELLED
  NO_SHOW
}

model NotificationLog {
  id             String      @id @default(cuid())
  restaurantId   String
  restaurant     Restaurant  @relation(fields: [restaurantId], references: [id])
  customerId     String?
  customer       Customer?   @relation(fields: [customerId], references: [id])
  reservationId  String?
  type           String
  phone          String
  message        String
  success        Boolean
  sentAt         DateTime    @default(now())
}

model MenuCategory {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  name         String
  description  String?
  position     Int        @default(0)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  items        MenuItem[]
}

model MenuItem {
  id          String       @id @default(cuid())
  categoryId  String
  category    MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Float?
  imageUrl    String?
  tags        String[]
  isActive    Boolean      @default(true)
  isSoldOut   Boolean      @default(false)
  position    Int          @default(0)
  createdAt   DateTime     @default(now())
}
